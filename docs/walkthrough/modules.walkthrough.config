// ===========================================================================
// WALKTHROUGH TEST conf/modules.config for Part II (Metatranscriptomics).
// Derived from the repo's conf/modules.config; ONLY the resource directives
// are shrunk for the tiny 2-sample toy run (cpus 16-32 -> 4; time 4h-7day ->
// 1h*attempt; mem 32-64GB -> 8GB*attempt; maxRetries/retry caps 15-25 -> 2).
// Containers, containerOptions/mounts, publishDir, and all process logic are
// UNCHANGED. Copy over src/metatranscriptome/conf/modules.config for a toy run;
// git-revert for a real run (the stock values are sized for the 75k dataset).
// ===========================================================================
process {
    maxRetries = 2

    withLabel: 'use_scratch' {
        scratch = true
    }

    // --------
    // Assembly
    // --------
    withName: 'SPADES_(SINGLE|PAIRED)_END' {
        container = 'docker://staphb/spades'
        conda = 'bioconda::spades=3.15.5'

        cpus = 4
        time = { 1.hour * task.attempt }
        errorStrategy = {
            (task.exitStatus == 100 || task.attempt > 2) ? 'ignore' : 'retry'
        }
    }
    withName: 'SPADES_SINGLE_END' {
        publishDir = [
            path: { "${params.publish_dir}/single_end" }
        ]
        memory = { 8.GB * task.attempt }
    }
    withName: 'SPADES_PAIRED_END' {
        publishDir = [
            path: { "${params.publish_dir}/paired_end" }
        ]
        memory = { 8.GB * task.attempt }
    }

    // ---------
    // Pre-BLAST
    // ---------
    withName: 'CHUNK_ASSEMBLED_FASTAS*' {
        container = 'staphb/seqkit'
    }

    // -----
    // BLAST
    // -----
    withName: 'BLAST' {
        container = 'staphb/blast:2.15.0'
        containerOptions = { "--mount type=bind,src=${params.nt_dir},dst=/db" }

        cpus = 4
        time = { 1.hour * task.attempt }
        memory = { 8.GB * task.attempt }
        errorStrategy = { task.attempt > 2 ? 'ignore' : 'retry' }
    }
    withName: 'CUT_BLAST_RESULTS' {
        container = 'staphb/seqtk:1.4'
        publishDir = [
            path: { "${params.publish_dir}/non_zf_hum_fa" }
        ]
    }

    withName: 'BLAST_FULL_NT' {
        publishDir = [
            path: { "${params.publish_dir}/nt_blast" }
        ]
        container = 'staphb/blast:2.15.0'
        containerOptions = { "--mount type=bind,src=${params.ntfull_dir},dst=/db" }

        cpus = 4
        time = { 1.hour * task.attempt }
        memory = { 8.GB * task.attempt }
        errorStrategy = { task.attempt > 2 ? 'ignore' : 'retry' }
    }

    // -------
    // DIAMOND
    // -------
    withName: 'CHUNK_NONZFHUM_FASTA' {
        container = 'staphb/seqkit'
    }
    withName: 'DIAMOND' {
        publishDir = [
            path: { "${params.publish_dir}/nr_diamond" }
        ]
        container = 'staphb/diamond:2.1.9'
        containerOptions = { "--mount type=bind,src=${params.nr_dir},dst=/db" }

        cpus = 4
        time = { 1.hour * task.attempt }
        memory = { 8.GB * task.attempt }
        errorStrategy = { task.attempt > 2 ? 'ignore' : 'retry' }
    }

    // --------
    // TAXONOMY
    // --------
    withName: 'PROCESS_BLAST' {
        container = 'file://./containers/taxonomy.sif'
        containerOptions = { "--mount type=bind,src=${params.taxonomy_db},dst=/tax.sqlite" }

        cpus = 1
        memory = { 8.GB * task.attempt }
    }
    withName: 'PROCESS_DIAMOND' {
        container = 'file://./containers/taxonomy.sif'
        containerOptions = { "--mount type=bind,src=${params.taxonomy_db},dst=/tax.sqlite" }

        cpus = 4
        memory = { 8.GB * task.attempt }
    }
    withName: 'ALLUVIAL_PLOT' {
        container = 'file://./containers/taxonomy.sif'
    }
}
