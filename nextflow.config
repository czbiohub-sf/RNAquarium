params {
    sra_tab_file   = null
    accession_list = null
    bioproj_map    = null
    gsnap_dir      = null
}

profiles {
    test {
        params.sra_tab_file   = "/hpc/projects/balla_group/sra_experiments/SRA_metadata/SRA_Accessions.tab"
        params.bioproj_map    = "$projectDir/test/sample_mapping.json"
        params.gsnap_dir      = "/hpc/projects/balla_group/sra_experiments/RNAquarium_prototyping/rnaquarium_unmapped_sample/"
    }

    bruno {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.executor       = 'slurm'
    }
}
