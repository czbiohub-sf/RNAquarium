includeConfig 'conf/modules.config'

report.overwrite   = true
timeline.overwrite = true

params {
    publish_dir         = "$projectDir"
    db_dir              = "$projectDir/db"
    sra_tab_file        = null
    accession_list      = null
    bioproj_map         = null
    unmerged_accessions = null

    // ---------
    // PRE_BLAST
    // ---------

    num_blast_chunks = 20

    // -----
    // BLAST
    // -----

    nt_dir          = null
    nt_db_name      = null
    taxids          = "7954,9605"
    outfmt          = "6 qseqid sseqid staxid ssciname sskingdom pident length mismatch qcovs gapopen qstart qend sstart send evalue bitscore"
    evalue          = "1e-20"
    max_target_seqs = 1

    // -------------
    // BLAST_FULL_NT
    // -------------

    full_nt_outfmt          = "6 qseqid sseqid staxid ssciname sskingdom pident length mismatch qcovs gapopen qstart qend sstart send evalue bitscore stitle"
    full_nt_evalue          = 0.05
    full_nt_max_target_seqs = 100

    // -------
    // DIAMOND
    // -------

    nr_dir             = null
    num_diamond_chunks = 10
}

profiles {
    test {
        process.cache              = 'lenient'

        params.sra_tab_file        = "/hpc/projects/balla_group/sra_experiments/SRA_metadata/SRA_Accessions.tab"
        params.bioproj_map         = "$projectDir/test/sample_mapping.json"
        params.unmerged_accessions = "/hpc/projects/balla_group/sra_experiments/RNAquarium_prototyping/rnaquarium_unmapped_sample/"
        params.tax_btd             = "/hpc/projects/balla_group/sra_experiments/RNAquarium_prototyping/taxdb.btd"
        params.tax_bti             = "/hpc/projects/balla_group/sra_experiments/RNAquarium_prototyping/taxdb.bti"
        params.tax4blast           = "/hpc/projects/balla_group/sra_experiments/RNAquarium_prototyping/taxonomy4blast.sqlite3"
        params.nt_dir              = "/hpc/scratch/group.swe/db/nt_clustered"
        params.nr_dir              = "/hpc/scratch/group.data.science/eric_temp/databases/nr_clustered"
        params.nt_db_name          = "nt_compressed_shuffled.fa"
        params.num_blast_chunks    = 4
        params.num_diamond_chunks  = 5
    }

    slurm {
        process {
            executor       = 'slurm'
            clusterOptions = '--signal=B:USR2'
        }

        executor {
            queueSize = 50
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
    }

    conda {
        conda.enabled       = true
        conda.useMamba      = false
        singularity.enabled = false
    }

    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        singularity.enabled = false
    }
}
