//docker.enabled = true

profiles {
	testing {
		process {
			debug = true
			executor = 'local'
			errorStrategy = 'terminate'
		}
		docker {
			enabled = true
		}
	}
	slurm {
		process {
			executor = 'slurm'
			scratch = true
			errorStrategy = 'retry'
			maxRetries = 1
		}
	}
}

process {
	ext.python_version = '3.10.2'
	ext.biopython_version = '1.75'

	withLabel: sratools {
		container = "quay.io/biocontainers/sra-tools:3.0.0--pl5321hd0d85c6_1"
	}
	withlabel: median {
		cpus = "1"
		memory = "32MB"
		//container = "fastq-lengths:0.1.0"
	}
	withLabel: fastp {
		container = "quay.io/biocontainers/fastp:0.23.2--hadf994f_5"
	}
	withLabel: price {
		cpus = "4"
		//container = "price-assembler:1.2"
	}
	withLabel: star {
		container = "quay.io/biocontainers/star:2.7.10b--h9ee0642_0"
	}
	withLabel: samtools {
		container = "quay.io/biocontainers/samtools:1.16.1--h00cdaf9_2"
	}
	withLabel: htseq {
		container = "quay.io/biocontainers/htseq:2.0.2--py310h5aa3a86_1"
	}
}