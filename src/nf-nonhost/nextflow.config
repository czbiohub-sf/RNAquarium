//docker.enabled = true

profiles {
	testing {
		process {
			debug = true
			executor = 'local'
			errorStrategy = 'terminate'

			withLabel: 'network_limited' {
				cpus =  1
				memory = 2.GB
			}
			withLabel: 'mem_low' {
				cpus = 1
				memory = 1.GB
			}
			withLabel: 'mem_medium' {
				cpus = 4
				memory = 4.GB
			}
		}
		docker {
			enabled = true
		}	
	}
	slurm {
		process {
			executor = 'slurm'
			scratch = '/tmp/'
			errorStrategy = 'retry'
			maxRetries = 1

			withLabel: 'network_limited' {
				cpus = 1
				memory = 1.GB
			}
			withLabel: 'mem_low' {
				cpus = 1
				memory = 2.GB
			}
			withLabel: 'mem_medium' {
				cpus = 4
				memory = 30.GB
			}
			withLabel: 'cpu_medium' {
				cpus = 4
				memory = 4.GB
			}
		}
		singularity {
			enabled = true
		}
	}
}

process {
	ext.python_version = '3.10.2'
	ext.biopython_version = '1.75'

	withLabel: sratools {
		container = "quay.io/biocontainers/sra-tools:3.0.0--pl5321hd0d85c6_1"
	}
//	withlabel: median {
//		container = "fastq-lengths:0.1.0"
//	}
	withLabel: fastp {
		container = "quay.io/biocontainers/fastp:0.23.2--hadf994f_5"
	}
//	withLabel: price {
//		container = "price-assembler:1.2"
//	}
	withLabel: star {
		container = "quay.io/biocontainers/star:2.7.10b--h9ee0642_0"
	}
	withLabel: samtools {
		container = "quay.io/biocontainers/samtools:1.16.1--h00cdaf9_2"
	}
	withLabel: htseq {
		container = "quay.io/biocontainers/htseq:2.0.2--py310h5aa3a86_1"
	}
}
