Bootstrap: docker
From: ubuntu:25.04

%labels
    Author Yttria Aniseia & Gibraan Rahman

%help
    This container contains the dependencies to retrieve the unmapped reads.

%environment
    export PATH=$PATH:/hisat2-2.2.1

%post
    apt-get -y update
    apt-get -y install \
        wget \
        g++ \
        git \
        libcurl4-gnutls-dev \
        libz-dev \
        liblzma-dev \
        libbz2-dev \
        make

    # HISAT2
    cd /
    wget -O HISAT2.tar.gz https://github.com/DaehwanKimLab/hisat2/archive/refs/tags/v2.2.1.tar.gz
    tar -xzvf HISAT2.tar.gz
    cd hisat2-2.2.1
    make

    # BCFTools
    cd /
    pwd
    echo "BCFTools"
    echo $(pwd)
    git clone --recurse-submodules https://github.com/samtools/htslib.git
    git clone https://github.com/samtools/bcftools.git

    cd htslib
    make
    make install

    # STAR
    cd /
    wget -O STAR.tar.gz https://github.com/alexdobin/STAR/archive/refs/tags/STAR_2.7.10b_alpha_23-06-09.tar.gz
    tar -xzvf STAR.tar.gz
    cd STAR-STAR_2.7.10b_alpha_23-06-09/source
    make STAR
    cp STAR /usr/bin

%test
    STAR_OUTPUT=$(command -v STAR)
    if [ -z $STAR_OUTPUT ]; then
        echo "No STAR binary found"
        exit 1
    fi

    BGZIP_OUTPUT=$(command -v bgzip)
    if [ -z $BGZIP_OUTPUT ]; then
        echo "No bgzip binary found"
        exit 1
    fi

    # Sentinel for full suite of hisat2 commands.
    # For some reason was unable to create an array of hisat2 commands
    #     to iteratively test.
    HISAT2_OUTPUT=$(command -v hisat2)
    if [ -z $HISAT2_OUTPUT ]; then
        echo "No hisat2 binary found"
        exit 1
    fi

    echo "All binaries present"
